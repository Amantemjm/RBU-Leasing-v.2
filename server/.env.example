DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rbu_leasing?schema=public"
JWT_SECRET="change-me-in-prod"
JWT_EXPIRES_IN="1d"
PORT=5050

# Public base URL used to build owner-invite accept links (email + the officer's
# copyable link). Must be a host the invited owner can reach. If blank, the link
# is relative (works only when opened on the same host).
PUBLIC_BASE_URL="http://192.168.16.239:5050"

# --- Outbound email for owner invitations ---
# Leave MAIL_HOST blank to DISABLE sending: invites are logged and the officer
# copies the accept link instead (fully usable without SMTP).
# Preset below = Outlook / Hotmail / Live (personal Microsoft account):
MAIL_HOST="smtp-mail.outlook.com"
MAIL_PORT=587
MAIL_SECURE=false              # false = STARTTLS (587); true = SSL (465)
MAIL_USER="you@outlook.com"    # your personal email = the SMTP login
MAIL_PASS="your-app-password"  # an App Password if 2FA is on (NOT your normal password)
MAIL_FROM="you@outlook.com"    # sender address; keep equal to MAIL_USER so Outlook accepts "From"
# Other providers:
#   Gmail  -> MAIL_HOST=smtp.gmail.com        MAIL_PORT=587 MAIL_SECURE=false (App Password required)
#   Yahoo  -> MAIL_HOST=smtp.mail.yahoo.com   MAIL_PORT=465 MAIL_SECURE=true  (App Password required)
