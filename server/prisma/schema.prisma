generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  LEASING_OFFICER
  VIEWER
  UNIT_OWNER
  TENANT
}

enum UnitApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum UnitStatus {
  VACANT
  OCCUPIED
}

enum LeaseStatus {
  ACTIVE
  EXPIRED
  TERMINATED
}

enum InquiryCategory {
  RESIDENCES
  OFFICES
}

enum InquirerType {
  LESSOR
  LESSEE
}

enum InquiryStatus {
  NEW
  IN_PROGRESS
  CLOSED
}

enum InfoSheetStatus {
  REQUESTED
  SUBMITTED
  APPROVED
  RETURNED
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  passwordPlain String?   // recoverable copy for the admin credential list (internal tool)
  role         Role       @default(VIEWER)
  unitOwner    UnitOwner? @relation(fields: [unitOwnerId], references: [id])
  unitOwnerId  String?
  tenant       Tenant?    @relation(fields: [tenantId], references: [id])
  tenantId     String?
  assignedInquiries Inquiry[] @relation("InquiryAssignee")
  assignedOwners UnitOwner[] @relation("OwnerOfficer")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model UnitOwner {
  id         String                @id @default(cuid())
  name       String
  email      String?
  phone      String?
  address    String?
  assignedOfficer   User?          @relation("OwnerOfficer", fields: [assignedOfficerId], references: [id], onDelete: SetNull)
  assignedOfficerId String?
  units      Unit[]
  users      User[]
  lessorInfoSheets LessorInfoSheet[]
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
}

model LessorInfoSheet {
  id          String          @id @default(cuid())
  unitOwner   UnitOwner       @relation(fields: [unitOwnerId], references: [id])
  unitOwnerId String
  status      InfoSheetStatus @default(REQUESTED)
  data        Json            @default("{}")
  remarks     String?
  submittedAt DateTime?
  reviewedAt  DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model LesseeInfoSheet {
  id          String          @id @default(cuid())
  tenant      Tenant          @relation(fields: [tenantId], references: [id])
  tenantId    String
  status      InfoSheetStatus @default(REQUESTED)
  data        Json            @default("{}")
  remarks     String?
  submittedAt DateTime?
  reviewedAt  DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model Estate {
  id        String   @id @default(cuid())
  name      String   @unique
  towers    Tower[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tower {
  id        String   @id @default(cuid())
  name      String
  estate    Estate   @relation(fields: [estateId], references: [id])
  estateId  String
  units     Unit[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([estateId, name])
}

model Unit {
  id         String     @id @default(cuid())
  owner      UnitOwner  @relation(fields: [ownerId], references: [id])
  ownerId    String
  unitNumber String
  building   String?
  tower      Tower?     @relation(fields: [towerId], references: [id])
  towerId    String?
  floor      String?
  slotNo     String?
  type       String     @default("OTHER")
  sizeSqm    Decimal?
  baseRent   Decimal
  status     UnitStatus @default(VACANT)
  approvalStatus UnitApprovalStatus @default(APPROVED)
  leases     Lease[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model Tenant {
  id           String        @id @default(cuid())
  name         String
  email        String?
  phone        String?
  address      String?
  leases       Lease[]
  users        User[]
  requirements Requirement[]
  lesseeInfoSheets LesseeInfoSheet[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Requirement {
  id         String   @id @default(cuid())
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  tenantId   String
  filename   String
  mimeType   String
  size       Int
  data       Bytes
  uploadedAt DateTime @default(now())
}

model Lease {
  id          String      @id @default(cuid())
  unit        Unit        @relation(fields: [unitId], references: [id])
  unitId      String
  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  tenantId    String
  startDate   DateTime
  endDate     DateTime
  monthlyRent Decimal
  deposit     Decimal     @default(0)
  status      LeaseStatus @default(ACTIVE)
  advanceRent     String?
  securityDeposit String?
  modeOfPayment   String?
  serviceFee      String?
  source          String?
  renewalPeriod   String?
  remarks         String?
  managedBy       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Inquiry {
  id           String          @id @default(cuid())
  category     InquiryCategory
  inquirerType InquirerType
  inquiryType  String
  fullName     String
  email        String
  message      String?
  consent      Boolean
  status       InquiryStatus   @default(NEW)
  assignedTo   User?           @relation("InquiryAssignee", fields: [assignedToId], references: [id])
  assignedToId String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actorName String?
  actorRole String?
  action    String
  entity    String
  entityId  String?
  method    String
  path      String
  createdAt DateTime @default(now())

  @@index([createdAt])
}
