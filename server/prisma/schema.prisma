generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  LEASING_OFFICER
  VIEWER
  UNIT_OWNER
  TENANT
}

enum UnitApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum UnitStatus {
  VACANT
  OCCUPIED
}

enum LeaseStatus {
  ACTIVE
  EXPIRED
  TERMINATED
}

enum InquiryCategory {
  RESIDENCES
  OFFICES
}

enum InquirerType {
  LESSOR
  LESSEE
}

enum InquiryStatus {
  NEW
  IN_PROGRESS
  CLOSED
}

enum InfoSheetStatus {
  REQUESTED
  SUBMITTED
  APPROVED
  RETURNED
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  passwordPlain String?   // recoverable copy for the admin credential list (internal tool)
  role         Role       @default(VIEWER)
  unitOwner    UnitOwner? @relation(fields: [unitOwnerId], references: [id])
  unitOwnerId  String?
  tenant       Tenant?    @relation(fields: [tenantId], references: [id])
  tenantId     String?
  assignedInquiries Inquiry[] @relation("InquiryAssignee")
  assignedOwners UnitOwner[] @relation("OwnerOfficer")
  assignedTransactions LeasingTransaction[] @relation("TxnOfficer")
  pageFormEntries PageFormEntry[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model UnitOwner {
  id         String                @id @default(cuid())
  name       String
  email      String?
  phone      String?
  address    String?
  assignedOfficer   User?          @relation("OwnerOfficer", fields: [assignedOfficerId], references: [id], onDelete: SetNull)
  assignedOfficerId String?
  units      Unit[]
  users      User[]
  lessorInfoSheets LessorInfoSheet[]
  leasingTransactions LeasingTransaction[]
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
}

model LessorInfoSheet {
  id          String          @id @default(cuid())
  unitOwner   UnitOwner       @relation(fields: [unitOwnerId], references: [id])
  unitOwnerId String
  status      InfoSheetStatus @default(REQUESTED)
  data        Json            @default("{}")
  filledPdf   Bytes? // the interactive PDF the lessor filled and submitted
  remarks     String?
  submittedAt DateTime?
  reviewedAt  DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model LesseeInfoSheet {
  id          String          @id @default(cuid())
  tenant      Tenant          @relation(fields: [tenantId], references: [id])
  tenantId    String
  status      InfoSheetStatus @default(REQUESTED)
  data        Json            @default("{}")
  filledPdf   Bytes? // the interactive PDF the lessee filled and submitted
  remarks     String?
  submittedAt DateTime?
  reviewedAt  DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model Estate {
  id        String   @id @default(cuid())
  name      String   @unique
  towers    Tower[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tower {
  id        String   @id @default(cuid())
  name      String
  estate    Estate   @relation(fields: [estateId], references: [id])
  estateId  String
  units     Unit[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([estateId, name])
}

model Unit {
  id         String     @id @default(cuid())
  owner      UnitOwner  @relation(fields: [ownerId], references: [id])
  ownerId    String
  unitNumber String
  building   String?
  tower      Tower?     @relation(fields: [towerId], references: [id])
  towerId    String?
  floor      String?
  slotNo     String?
  type       String     @default("OTHER")
  sizeSqm    Decimal?
  baseRent   Decimal
  status     UnitStatus @default(VACANT)
  approvalStatus UnitApprovalStatus @default(APPROVED)
  leases     Lease[]
  leasingTransactions LeasingTransaction[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model Tenant {
  id           String        @id @default(cuid())
  name         String
  email        String?
  phone        String?
  address      String?
  leases       Lease[]
  users        User[]
  requirements Requirement[]
  lesseeInfoSheets LesseeInfoSheet[]
  leasingTransactions LeasingTransaction[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

// Admin-built forms (CMS). `fields` is a JSON array of field definitions
// ({ key, label, type, required, placeholder, options }) matching the shape the
// client ConfigurableForm renders.
model CmsForm {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  fields      Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// A custom field set the Super Admin attaches to one (role, page) navigation
// slot — e.g. the Lessee's "Acceptance Form" page. `fields` uses the same JSON
// shape as CmsForm. Users of that role see these fields on that page and their
// answers are stored as PageFormEntry rows.
model PageForm {
  id        String          @id @default(cuid())
  role      Role
  pageKey   String
  title     String?
  fields    Json            @default("[]")
  entries   PageFormEntry[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([role, pageKey])
}

// One user's saved answers to a PageForm (one row per user per form; upserted).
model PageFormEntry {
  id         String   @id @default(cuid())
  pageForm   PageForm @relation(fields: [pageFormId], references: [id], onDelete: Cascade)
  pageFormId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  data       Json     @default("{}")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([pageFormId, userId])
}

model Requirement {
  id         String   @id @default(cuid())
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  tenantId   String
  filename   String
  mimeType   String
  size       Int
  data       Bytes
  uploadedAt DateTime @default(now())
}

model Lease {
  id          String      @id @default(cuid())
  unit        Unit        @relation(fields: [unitId], references: [id])
  unitId      String
  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  tenantId    String
  startDate   DateTime
  endDate     DateTime
  monthlyRent Decimal
  deposit     Decimal     @default(0)
  status      LeaseStatus @default(ACTIVE)
  advanceRent     String?
  securityDeposit String?
  modeOfPayment   String?
  serviceFee      String?
  source          String?
  renewalPeriod   String?
  remarks         String?
  managedBy       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Inquiry {
  id           String          @id @default(cuid())
  category     InquiryCategory
  inquirerType InquirerType
  inquiryType  String
  fullName     String
  email        String
  message      String?
  consent      Boolean
  status       InquiryStatus   @default(NEW)
  assignedTo   User?           @relation("InquiryAssignee", fields: [assignedToId], references: [id])
  assignedToId String?
  leasingTransaction LeasingTransaction?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

// The single source of truth for one end-to-end leasing transaction. Progresses
// through the stages defined in shared/leasingStages.js; `stage`/`status`/
// `finalStatus` are validated against that registry (kept as strings, not PG
// enums, so the many per-stage statuses stay flexible under manual migrations).
model LeasingTransaction {
  id          String   @id @default(cuid())
  reference   String   @unique // RBU-YYYY-NNNNNN
  stage       String   // current stage key
  status      String   // current status within the stage
  finalStatus String?  // set once the transaction reaches the Status stage
  stageData   Json     @default("{}") // per-stage { status, remarks, completedAt, startedAt }
  lesseeName  String?  // denormalised from the inquiry for quick display

  inquiry     Inquiry?   @relation(fields: [inquiryId], references: [id])
  inquiryId   String?    @unique
  unit        Unit?      @relation(fields: [unitId], references: [id])
  unitId      String?
  tenant      Tenant?    @relation(fields: [tenantId], references: [id])
  tenantId    String?
  unitOwner   UnitOwner? @relation(fields: [unitOwnerId], references: [id])
  unitOwnerId String?
  assignedOfficer   User? @relation("TxnOfficer", fields: [assignedOfficerId], references: [id])
  assignedOfficerId String?

  events      TransactionEvent[]
  documents   TransactionDocument[]
  approvalSteps ApprovalStep[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Supporting documents uploaded against a transaction (e.g. the lessee's
// Approval-stage requirements). Binary held in `data`, like Requirement.
model TransactionDocument {
  id            String   @id @default(cuid())
  transaction   LeasingTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  transactionId String
  filename      String
  mimeType      String
  size          Int
  data          Bytes
  stage         String?  // stage the document was uploaded under
  uploadedById  String?
  uploadedByName String?
  createdAt     DateTime @default(now())

  @@index([transactionId])
}

// One step of a transaction's sequential approval routing chain
// (Leasing → Management → Authorized Approver → Final Approval).
model ApprovalStep {
  id            String   @id @default(cuid())
  transaction   LeasingTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  transactionId String
  order         Int
  name          String
  status        String   @default("Pending") // Pending / Approved / Rejected / Returned
  approverId    String?
  approverName  String?
  remarks       String?
  decidedAt     DateTime?
  createdAt     DateTime @default(now())

  @@unique([transactionId, order])
  @@index([transactionId])
}

// Append-only activity log for a transaction (who did what, when).
model TransactionEvent {
  id            String   @id @default(cuid())
  transaction   LeasingTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  transactionId String
  actorId       String?
  actorName     String?
  actorRole     String?
  stage         String?
  message       String
  createdAt     DateTime @default(now())

  @@index([transactionId])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actorName String?
  actorRole String?
  action    String
  entity    String
  entityId  String?
  method    String
  path      String
  createdAt DateTime @default(now())

  @@index([createdAt])
}
